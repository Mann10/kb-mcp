{
    "mcpServers": {
        "knowledge-base": {
            "command": "npx",
            "args": [
                "-y",
                "mcp-remote",
                "http://localhost:8000/mcp",
                "--allow-http",
                "--header",
                "X-API-Token:${KB_TOKEN}"
            ],
            "env": {
                "KB_TOKEN": "<paste-your-token-here>"
            }
        }
    }
}